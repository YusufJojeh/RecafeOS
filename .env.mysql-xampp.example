# Local-only MySQL/XAMPP compatibility mode.
# This is supported for core venue operations only.
# Production remains PostgreSQL-only.

NODE_ENV=development
PORT=3000
DB_PROVIDER=mysql
ALLOW_MYSQL_LOCAL=true

# Default XAMPP MySQL DSN.
# If your root user has a password, encode it in the URL.
DATABASE_URL=mysql://root:@127.0.0.1:3306/restocafe

JWT_ACCESS_SECRET=change-me-access-min-32-chars-long!!
JWT_REFRESH_SECRET=change-me-refresh-min-32-chars!!
JWT_ACCESS_TTL=900s
JWT_REFRESH_TTL=7d
LOG_LEVEL=debug
CORS_ORIGIN=http://localhost:5173
APP_PUBLIC_URL=http://localhost:3000
VITE_API_URL=http://localhost:3000/api/v1

# Optional local Redis. Leave unset for single-process local work.
# REDIS_URL=redis://127.0.0.1:6379
# IDEMPOTENCY_REQUIRE_REDIS=false

# Limitations:
# - reports and analytics endpoints remain PostgreSQL-only
# - AI insights that depend on reports also remain PostgreSQL-only
# - use `npm run db:migrate:deploy:mysql`, not `prisma migrate dev`, for this local path
