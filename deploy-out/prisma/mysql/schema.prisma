generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  IN_PREPARATION
  READY
  SERVED
  PAID
  CANCELLED
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  WHATSAPP_MANUAL
  QR_REQUEST
}

enum PrepTicketStatus {
  NEW
  ACCEPTED
  PREPARING
  READY
  DELIVERED
}

enum FloorTableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  CLEANING
}

enum PrepStation {
  KITCHEN
  BAR
  BOTH
}

enum TableSessionStatus {
  OPEN
  CLOSED
}

enum PaymentMethod {
  CASH
  CARD
  OTHER
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
}

enum StockMovementType {
  SALE_DEDUCTION
  ADJUSTMENT
  INITIAL
}

enum SubscriptionPlan {
  trial
  starter
  growth
  scale
}

enum BillingStatus {
  trialing
  active
  past_due
  canceled
  suspended
}

enum PilotFeedbackType {
  bug
  onboarding_issue
  training_issue
  support_issue
  product_gap
  feature_request
  nice_to_have
}

enum PilotFeedbackSeverity {
  sev1
  sev2
  sev3
  sev4
  low
}

enum PilotEvidenceQuality {
  logged_request_id
  screenshot
  verbal_only
}

enum PilotFeedbackStatus {
  open
  triaged
  resolved
  closed
}

enum CustomerNoteCategory {
  GENERAL
  PREFERENCE
  ALLERGY
  COMPLAINT
}

enum OfferKind {
  MANUAL
  REPEAT_WINBACK
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptionPlan SubscriptionPlan @default(starter)
  billingStatus    BillingStatus    @default(active)
  trialEndsAt      DateTime?
  currentPeriodEnd   DateTime?
  stripeCustomerId     String?
  stripeSubscriptionId String?
  /** When set, overrides plan default max branches. */
  maxBranches        Int?
  /** When set, overrides plan default max staff users (seats). */
  maxUsers           Int?
  metadata           Json             @default("{}")

  branches Branch[]
  members  TenantMember[]
  customers Customer[]
  roles    Role[]
  orders   Order[]
  pilotFeedbackItems PilotFeedbackItem[]
  pilotWeeklySnapshots PilotWeeklySnapshot[]
  staffInvites StaffInvite[]
  staffPushDevices StaffPushDevice[]
  menuBranding TenantMenuBranding?

  @@index([subscriptionPlan])
  /** Covers billingStatus-only filters and expireDueTrials (trialing + trialEndsAt). */
  @@index([billingStatus, trialEndsAt])
}

model TenantMenuBranding {
  id       String @id @default(cuid())
  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  draftJson     Json      @default("{}")
  publishedJson Json?

  logoDraftKey     String?
  logoPublishedKey String?

  logoAnalysisJson Json?

  publishedAt DateTime?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

model PilotFeedbackItem {
  id                    String               @id @default(cuid())
  tenantId              String
  branchId              String?
  feedbackType          PilotFeedbackType
  severity              PilotFeedbackSeverity
  moduleTag             String?
  blastRadius           String?
  evidenceQuality       PilotEvidenceQuality @default(verbal_only)
  title                 String
  description           String
  requestId             String?
  externalIncidentUrl   String?
  promotedToEngineering Boolean              @default(false)
  status                PilotFeedbackStatus  @default(open)
  themeKey              String?
  businessCritical      Boolean              @default(false)
  triageNotes           String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  createdByOperator     String?

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([tenantId, status])
}

model PilotWeeklySnapshot {
  id          String   @id @default(cuid())
  tenantId    String
  /** Start of ISO week (UTC date boundary) stored as midnight UTC. */
  weekStart   DateTime
  pilotHealth String?
  jsonPayload Json     @default("{}")
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, weekStart])
  @@index([weekStart])
}

model Branch {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  slug        String
  timezone    String   @default("UTC")
  currency    String   @default("USD")
  settings    Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  floorTables      FloorTable[]
  categories       MenuCategory[]
  menuItems        MenuItem[]
  modifierGroups   ModifierGroup[]
  orders           Order[]
  stockItems       StockItem[]
  preparationTickets PreparationTicket[]
  shifts           Shift[]
  auditLogs        AuditLog[]
  tableSessions    TableSession[]
  waiterCalls      WaiterCall[]
  stockMovements   StockMovement[]
  customerVisits   CustomerVisit[]
  customerNotes    CustomerNote[]
  pilotFeedbackItems PilotFeedbackItem[]
  membersDefaultBranch TenantMember[] @relation("TenantMemberDefaultBranch")

  @@unique([tenantId, slug])
  @@index([tenantId])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  displayName  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships TenantMember[]
  refreshTokens RefreshToken[]
  auditLogs   AuditLog[] @relation("AuditActor")
  customerNotesCreated CustomerNote[]
  staffPushDevices StaffPushDevice[]
}

model StaffPushDevice {
  id        String   @id @default(cuid())
  userId    String
  tenantId  String
  platform  String
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId, platform, token])
  @@index([tenantId])
  @@index([userId, tenantId])
}

model Role {
  id        String   @id @default(cuid())
  tenantId  String?
  name      String
  createdAt DateTime @default(now())

  tenant      Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  members     TenantMember[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Permission {
  id   String @id @default(cuid())
  code String @unique

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model TenantMember {
  id                String   @id @default(cuid())
  userId            String
  tenantId          String
  roleId            String
  defaultBranchId   String?
  createdAt         DateTime @default(now())

  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant  Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role    Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)
  defaultBranch Branch? @relation("TenantMemberDefaultBranch", fields: [defaultBranchId], references: [id], onDelete: SetNull)

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@index([userId])
  @@index([defaultBranchId])
}

/** Time-limited staff onboarding token (manager / cashier / kitchen only). */
model StaffInvite {
  id              String    @id @default(cuid())
  tenantId        String
  email           String
  roleName        String
  tokenHash       String    @unique
  expiresAt       DateTime
  defaultBranchId String?
  createdByUserId String
  usedAt          DateTime?
  createdAt       DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, email])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model FloorTable {
  id        String           @id @default(cuid())
  branchId  String
  label     String
  sortOrder Int              @default(0)
  status    FloorTableStatus @default(AVAILABLE)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  branch   Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  sessions TableSession[]

  @@index([branchId, status])
}

/// Enforced in DB: at most one OPEN session per floor table (partial unique index in migrations).
model TableSession {
  id           String             @id @default(cuid())
  branchId     String
  floorTableId String
  publicToken  String             @unique @default(cuid())
  guestCount   Int                @default(1)
  status       TableSessionStatus @default(OPEN)
  openedAt     DateTime           @default(now())
  closedAt     DateTime?

  branch     Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  floorTable FloorTable @relation(fields: [floorTableId], references: [id], onDelete: Cascade)
  orders     Order[]
  waiterCalls WaiterCall[]

  @@index([branchId, status])
  @@index([publicToken])
}

model MenuCategory {
  id        String   @id @default(cuid())
  branchId  String
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  items  MenuItem[]

  @@index([branchId])
}

model MenuItem {
  id          String      @id @default(cuid())
  branchId    String
  categoryId  String
  name        String
  description String?
  priceMinor  Int
  imageUrl    String?
  visible     Boolean     @default(true)
  available   Boolean     @default(true)
  prepStation PrepStation @default(KITCHEN)
  sortOrder   Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  category MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  modifierGroups MenuItemModifierGroup[]
  orderItems     OrderItem[]
  recipes        ItemRecipe[]

  @@index([branchId, categoryId])
  @@index([branchId, available])
}

model ModifierGroup {
  id        String   @id @default(cuid())
  branchId  String
  name      String
  minSelect Int      @default(0)
  maxSelect Int      @default(1)
  required  Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch  Branch                   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  options ModifierOption[]
  items   MenuItemModifierGroup[]

  @@index([branchId])
}

model ModifierOption {
  id         String   @id @default(cuid())
  groupId    String
  name       String
  priceDelta Int      @default(0)
  sortOrder  Int      @default(0)

  group ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  orderItemModifiers OrderItemModifier[]

  @@index([groupId])
}

model MenuItemModifierGroup {
  menuItemId       String
  modifierGroupId  String

  menuItem       MenuItem      @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  modifierGroup  ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)

  @@id([menuItemId, modifierGroupId])
}

model Order {
  id               String      @id @default(cuid())
  tenantId         String
  branchId         String
  type             OrderType
  status           OrderStatus @default(DRAFT)
  tableSessionId   String?
  customerId       String?
  sourceNote       String?
  discountMinor    Int         @default(0)
  discountPercent  Int         @default(0)
  discountReason   String?
  subtotalMinor    Int         @default(0)
  totalMinor       Int         @default(0)
  version          Int         @default(1)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  paidAt           DateTime?
  cancelledAt      DateTime?
  /// Staff-selected bucket when cancelling (e.g. kitchen_timeout); optional for legacy rows.
  cancellationReason String?
  cancellationNote   String?

  branch       Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  tableSession TableSession? @relation(fields: [tableSessionId], references: [id], onDelete: SetNull)
  customer     Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)

  tenantRelation Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  items              OrderItem[]
  preparationTickets PreparationTicket[]
  payments           Payment[]
  stockMovements     StockMovement[]
  customerVisits     CustomerVisit[]

  @@index([branchId, status, createdAt])
  @@index([branchId, tenantId, status, paidAt])
  @@index([branchId, tenantId, status, cancelledAt])
  @@index([tenantId])
  @@index([tenantId, branchId])
  @@index([tableSessionId])
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  menuItemId String
  quantity   Int      @default(1)
  unitPriceMinor Int
  lineTotalMinor Int
  notes      String?

  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Restrict)

  modifiers OrderItemModifier[]
  preparationTickets PreparationTicket[]

  @@index([orderId])
  @@index([menuItemId])
  @@index([orderId, menuItemId])
}

model OrderItemModifier {
  id                 String @id @default(cuid())
  orderItemId        String
  modifierOptionId   String
  priceDeltaMinor    Int    @default(0)

  orderItem      OrderItem      @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  modifierOption ModifierOption @relation(fields: [modifierOptionId], references: [id], onDelete: Restrict)

  @@index([orderItemId])
}

model PreparationTicket {
  id          String           @id @default(cuid())
  branchId    String
  orderId     String
  orderItemId String
  station     PrepStation
  status      PrepTicketStatus @default(NEW)
  priority    Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  branch    Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  /** At most one prep ticket per order line per station (kitchen vs bar for BOTH items). */
  @@unique([orderId, orderItemId, station])
  @@index([branchId, station, status, createdAt])
  @@index([orderId])
}

model Payment {
  id          String        @id @default(cuid())
  orderId     String        @unique
  amountMinor Int
  method      PaymentMethod @default(CASH)
  status      PaymentStatus @default(COMPLETED)
  recordedByUserId String?
  createdAt   DateTime      @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([recordedByUserId])
  @@index([createdAt])
}

model Shift {
  id         String   @id @default(cuid())
  branchId   String
  openedAt   DateTime @default(now())
  closedAt   DateTime?
  openedById String?
  closedById String?
  note       String?

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([branchId, openedAt])
}

model Customer {
  id        String   @id @default(cuid())
  tenantId  String
  phone     String
  name      String?
  notes     String?
  visitCount Int     @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  orders Order[]
  visits CustomerVisit[]
  offers Offer[]
  noteEntries CustomerNote[]
  tagEntries CustomerTag[]

  @@unique([tenantId, phone])
  @@index([tenantId])
}

model CustomerTag {
  customerId String
  value      String
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@id([customerId, value])
  @@index([value])
}

model CustomerVisit {
  id         String   @id @default(cuid())
  customerId String
  branchId   String
  visitedAt  DateTime @default(now())
  orderId    String?

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  branch   Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  order    Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([orderId])
  @@index([branchId, visitedAt])
  @@index([customerId, branchId, visitedAt])
}

model CustomerNote {
  id              String               @id @default(cuid())
  customerId      String
  branchId        String?
  category        CustomerNoteCategory   @default(GENERAL)
  body            String
  createdAt       DateTime             @default(now())
  createdByUserId String?

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  branch   Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  createdBy User?   @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([customerId, createdAt])
}

model Offer {
  id          String   @id @default(cuid())
  customerId  String
  title       String
  description String?
  kind        OfferKind @default(MANUAL)
  validUntil  DateTime?
  redeemed    Boolean  @default(false)
  redeemedAt  DateTime?
  createdAt   DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

model StockItem {
  id           String   @id @default(cuid())
  branchId     String
  name         String
  unit         String   @default("unit")
  quantity     Decimal  @db.Decimal(12, 4)
  lowThreshold Decimal  @db.Decimal(12, 4)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  branch    Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  movements StockMovement[]
  recipes   ItemRecipe[]

  @@index([branchId])
}

model ItemRecipe {
  id         String  @id @default(cuid())
  menuItemId String
  stockItemId String
  qtyPerUnit Decimal @db.Decimal(12, 4)

  menuItem  MenuItem  @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  stockItem StockItem @relation(fields: [stockItemId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, stockItemId])
}

model StockMovement {
  id          String             @id @default(cuid())
  branchId    String
  stockItemId String
  orderId     String?
  type        StockMovementType
  delta       Decimal            @db.Decimal(12, 4)
  note        String?
  createdAt   DateTime           @default(now())

  branch    Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  stockItem StockItem @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  order     Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([branchId, createdAt])
  @@index([stockItemId])
  @@index([orderId])
}

model WaiterCall {
  id               String    @id @default(cuid())
  branchId         String
  tableSessionId   String
  message          String?
  acknowledgedAt   DateTime?
  createdAt        DateTime  @default(now())

  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  tableSession TableSession @relation(fields: [tableSessionId], references: [id], onDelete: Cascade)

  @@index([branchId, createdAt])
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  tenantId  String?
  name      String
  payload   Json?
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([name, createdAt])
  /** Age-based retention deletes if implemented (see docs/operations/analytics-events-retention.md). */
  @@index([createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  branchId  String?
  actorId   String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  actor  User?   @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([branchId])
  /** Global age-based retention deletes (see audit-retention.service). */
  @@index([createdAt])
}
