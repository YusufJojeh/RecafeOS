# API
NODE_ENV=development
PORT=3000
DB_PROVIDER=postgresql
ALLOW_MYSQL_LOCAL=false

# Database - official target is PostgreSQL.
# For local XAMPP/MySQL compatibility mode, keep this file for shared app settings
# and create `.env.mysql-xampp` from `.env.mysql-xampp.example`.
# Add connection_limit for production. Size as: (limit x API replicas) < 70% of Postgres max_connections.
# Dev default has no limit (Prisma uses its internal pool heuristic). Production example: connection_limit=15&pool_timeout=10
DATABASE_URL=postgresql://restocafe:restocafe@localhost:5432/restocafe?schema=public

REDIS_URL=redis://localhost:6379
IDEMPOTENCY_REQUIRE_REDIS=false
JWT_ACCESS_SECRET=change-me-access-min-32-chars-long!!
JWT_REFRESH_SECRET=change-me-refresh-min-32-chars!!
JWT_ACCESS_TTL=900s
JWT_REFRESH_TTL=7d
LOG_LEVEL=debug
CORS_ORIGIN=http://localhost:5173
SUPPORT_UI_ENABLED=true
# SUPPORT_UI_ALLOWED_EMAILS=owner@demo.local,ops@example.com
# Public API base for guest QR / menu URLs. Required when NODE_ENV=production.
APP_PUBLIC_URL=http://localhost:3000
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=restocafe
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345
S3_PUBLIC_BASE_URL=http://localhost:9000/restocafe

# Frontend (Vite)
VITE_API_URL=http://localhost:3000/api/v1
VITE_LANDING_DEMO_URL=#contact
VITE_LANDING_CONTACT_EMAIL=hello@restocafe.io
VITE_LANDING_WHATSAPP_NUMBER=966500000000

# API-only env reference: apps/api/.env.example (same variable names for shared keys).

# Quick local PostgreSQL bootstrap
# 1) pnpm run dev:setup
# 2) pnpm run dev:api
# 3) pnpm run dev:web

# Local XAMPP/MySQL compatibility mode
# 1) copy .env.mysql-xampp.example -> .env.mysql-xampp
# 2) start MySQL in XAMPP
# 3) pnpm run dev:setup:mysql
# 4) pnpm run dev:api:mysql
# 5) pnpm run dev:web

# Production (API container / systemd)
# NODE_ENV=production
# DB_PROVIDER=postgresql
# ALLOW_MYSQL_LOCAL=false
# TRUST_PROXY=true
# HELMET_ENABLED=true
# LOG_LEVEL=info
# SWAGGER_ENABLED=false
# METRICS_ENABLED=true                    # Required - exposes /api/v1/internal/metrics for Prometheus
# REDIS_URL=redis://redis:6379
# IDEMPOTENCY_REQUIRE_REDIS=true          # Production default; explicit false is rejected in production
# SUPPORT_UI_ENABLED=true
# SUPPORT_UI_ALLOWED_EMAILS=ops@example.com,oncall@example.com
# APP_PUBLIC_URL=https://api.example.com  # Needed for guest QR links / public menu URLs
# APP_VERSION=1.0.0
# GIT_SHA=abc123
# RUN_MIGRATIONS_ON_START=false
# SUPPORT_API_KEY=
