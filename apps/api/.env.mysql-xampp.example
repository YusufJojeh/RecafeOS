# Local-only MySQL/XAMPP compatibility mode.
# Supported for API boot and core venue operations only.

NODE_ENV=development
PORT=3000
DB_PROVIDER=mysql
ALLOW_MYSQL_LOCAL=true
DATABASE_URL=mysql://root:@127.0.0.1:3306/restocafe

JWT_ACCESS_SECRET=change-me-access-min-32-chars-long!!
JWT_REFRESH_SECRET=change-me-refresh-min-32-chars!!
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
LOG_LEVEL=debug
CORS_ORIGIN=http://localhost:5173
APP_PUBLIC_URL=http://localhost:3000

# Optional local Redis. Leave unset for one API process.
# REDIS_URL=redis://127.0.0.1:6379
# IDEMPOTENCY_REQUIRE_REDIS=false

# Production never uses this file. MySQL mode stays local-only and may use
# in-memory idempotency only for a single API process.

# Limitations:
# - branch and tenant reporting endpoints return 501 in local MySQL mode
# - AI insights depending on reports also return 501
# - use the checked-in MySQL migration tree via `npm run db:migrate:deploy:mysql`
