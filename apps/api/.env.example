NODE_ENV=development
PORT=3000
DB_PROVIDER=postgresql
ALLOW_MYSQL_LOCAL=false

# Official target: PostgreSQL.
# For local XAMPP/MySQL compatibility mode, use `.env.mysql-xampp`.
# Optional connection_limit example:
# postgresql://user:pass@host:5432/db?schema=public&connection_limit=10
DATABASE_URL=postgresql://restocafe:restocafe@localhost:5432/restocafe?schema=public

JWT_ACCESS_SECRET=change-me-access-min-32-chars-long!!
JWT_REFRESH_SECRET=change-me-refresh-min-32-chars!!
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
LOG_LEVEL=debug
CORS_ORIGIN=http://localhost:5173
SUPPORT_UI_ENABLED=true
# SUPPORT_UI_ALLOWED_EMAILS=owner@demo.local,ops@example.com
# Public base URL for guest QR / menu links. Required when NODE_ENV=production (http/https).
APP_PUBLIC_URL=http://localhost:3000

# Shared idempotency + Socket.IO adapter when scaling beyond one API process.
# REDIS_URL=redis://127.0.0.1:6379
IDEMPOTENCY_REQUIRE_REDIS=false

# Staff push outbox: seconds before a stuck PROCESSING row is reclaimed (default 300).
# STAFF_PUSH_STALE_PROCESSING_SEC=300

# Real FCM delivery (optional). Default STAFF_PUSH_PROVIDER=noop.
# STAFF_PUSH_PROVIDER=fcm
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}  # single-line JSON; required in production when PROVIDER=fcm
# STAFF_PUSH_FCM_DRY_RUN=false
# STAFF_PUSH_FCM_LOG_FAILURES=false

# Production hardening
# TRUST_PROXY=true
# HELMET_ENABLED=true
# LOG_LEVEL=info
# SWAGGER_ENABLED=false
# METRICS_ENABLED=true   # Set true in production so /api/v1/internal/metrics is exposed for Prometheus
# REDIS_URL=redis://redis:6379
# IDEMPOTENCY_REQUIRE_REDIS=true
# Guest QR orders: require Idempotency-Key (defaults to true in NODE_ENV=production)
# PUBLIC_GUEST_ORDER_REQUIRE_IDEMPOTENCY_KEY=true
# SUPPORT_UI_ENABLED=true
# SUPPORT_UI_ALLOWED_EMAILS=ops@example.com,oncall@example.com
# SUPPORT_API_KEY=

# Optional AI insights
# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_TIMEOUT_MS=15000
